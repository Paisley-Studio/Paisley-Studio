{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "vertex-key.json",
      "FIRESTORE_RULES.md"
    ],
    "redirects": [
      {
        "source": "/tutor",
        "destination": "/tutor/login.html",
        "type": 301
      },
      {
        "source": "/tutors",
        "destination": "/tutor/login.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/parent",
        "destination": "/parent/index.html"
      },
      {
        "source": "/parent/dashboard",
        "destination": "/parent/dashboard.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/student",
        "destination": "/student/index.html"
      },
      {
        "source": "/tutor/:slug",
        "destination": "/tutor/login.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}