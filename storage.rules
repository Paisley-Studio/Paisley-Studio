rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================
    // SHARED HELPERS
    // =====================================================
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function isTutor() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/tutorAccounts/$(request.auth.uid));
    }
    // 25MB cap on any single educational file
    function underSizeLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }
    function isEducationalFile() {
      return request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('audio/.*') ||
        request.resource.contentType.matches('video/.*');
    }

    // =====================================================
    // ACTIVITIES — question diagrams/media
    // =====================================================
    match /activities/{activityId}/questions/{questionId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || (isTutor() && (
          !firestore.exists(/databases/(default)/documents/activities/$(activityId)) ||
          firestore.get(/databases/(default)/documents/activities/$(activityId)).data.ownerId == request.auth.uid
        )))
        && underSizeLimit() && isEducationalFile();
    }

    // =====================================================
    // EXAMS — question diagrams
    // =====================================================
    match /exams/{examId}/questions/{questionId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() || isTutor() ||
        (firestore.exists(/databases/(default)/documents/exams/$(examId)) &&
          firestore.get(/databases/(default)/documents/exams/$(examId)).data.status == 'Published')
      );
      allow write: if (isAdmin() || (isTutor() && (
          !firestore.exists(/databases/(default)/documents/exams/$(examId)) ||
          firestore.get(/databases/(default)/documents/exams/$(examId)).data.tutorId == request.auth.uid
        )))
        && underSizeLimit() && isEducationalFile();
    }

    // =====================================================
    // HOMEWORK — attachments
    // =====================================================
    match /homework/{homeworkId}/attachments/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || (isTutor() && (
          !firestore.exists(/databases/(default)/documents/homework/$(homeworkId)) ||
          firestore.get(/databases/(default)/documents/homework/$(homeworkId)).data.tutorId == request.auth.uid
        )))
        && underSizeLimit() && isEducationalFile();
    }

    // =====================================================
    // SUBMISSIONS — student "working" uploads
    // =====================================================
    match /submissions/{submissionId}/questions/{questionId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() || isTutor() ||
        firestore.get(/databases/(default)/documents/submissions/$(submissionId)).data.studentId == request.auth.uid
      );
      allow write: if isSignedIn() &&
        firestore.get(/databases/(default)/documents/submissions/$(submissionId)).data.studentId == request.auth.uid &&
        underSizeLimit() && isEducationalFile();
    }

    match /examAttempts/{attemptId}/questions/{questionId}/{fileName} {
      allow read: if isSignedIn() && (
        isAdmin() || isTutor() ||
        firestore.get(/databases/(default)/documents/examAttempts/$(attemptId)).data.studentId == request.auth.uid
      );
      allow write: if isSignedIn() &&
        firestore.get(/databases/(default)/documents/examAttempts/$(attemptId)).data.studentId == request.auth.uid &&
        underSizeLimit() && isEducationalFile();
    }

    // =====================================================
    // CLASSROOM FILES — lesson attachments and notes images
    // Path: classroom-files/{subjectId}/{classroomId}/{lessonId}/{file}
    // =====================================================
    function classTutorFor(subjectId) {
      return isSignedIn() &&
        ('subjects' in firestore.get(/databases/(default)/documents/tutorAccounts/$(request.auth.uid)).data) &&
        subjectId in firestore.get(/databases/(default)/documents/tutorAccounts/$(request.auth.uid)).data.subjects;
    }
    function classFileOk() {
      return request.resource.size < 100 * 1024 * 1024 && (
        request.resource.contentType.matches('image/(jpeg|png|gif|webp)') ||
        request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('application/msword') ||
        request.resource.contentType.matches('application/vnd[.]openxmlformats-officedocument[.].*') ||
        request.resource.contentType.matches('application/vnd[.]ms-.*') ||
        request.resource.contentType.matches('text/(plain|csv)') ||
        request.resource.contentType.matches('audio/.*') ||
        request.resource.contentType.matches('video/.*')
      );
    }
    match /classroom-files/{subjectId}/{classroomId}/{lessonId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin() && classFileOk();
      allow delete: if isAdmin();
    }

    // =====================================================
    // RESOURCES FOLDER — marking schemes / further resources
    // Path: resource-files/{subjectId}/{resourceId}/{file}
    // =====================================================
    match /resource-files/{subjectId}/{resourceId}/{fileName} {
      allow get: if isAdmin() || classTutorFor(subjectId);
      allow list: if false;
      allow create, update: if isAdmin() && classFileOk();
      allow delete: if isAdmin();
    }

    // =====================================================
    // EXAM PDFs
    // Path: classroom-files/{subjectId}/{classroomId}/exams/{examId}/{fileName}
    // =====================================================
    match /classroom-files/{subjectId}/{classroomId}/exams/{examId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin() && classFileOk();
      allow delete: if isAdmin();
    }

    // =====================================================
    // FLAT-EXAM SUBMISSIONS — the student's completed exam paper
    // =====================================================
    // Any document, photo, spreadsheet or slide deck the marking screen can open
    // (js/classroom/file-convert.js). Keep in step with HANDIN_TYPES in work-helpers.js.
    // No HTML, SVG or scripts: nothing a browser would run.
    function studentWorkFileOk() {
      return request.resource.size < 25 * 1024 * 1024 && (
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|bmp|heic|heif|tiff|avif)') ||
        request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('application/(msword|rtf)') ||
        request.resource.contentType.matches('application/vnd[.]openxmlformats-officedocument[.].*') ||
        request.resource.contentType.matches('application/vnd[.]ms-(excel|powerpoint)([.].*)?') ||
        request.resource.contentType.matches('application/vnd[.]oasis[.]opendocument[.](text|spreadsheet|presentation)') ||
        request.resource.contentType.matches('text/(plain|csv)'));
    }
    function isParentOfStudent(studentId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/parentStudentLinks/$(request.auth.uid + '_' + studentId));
    }
    match /classroom-files/{subjectId}/{classroomId}/exams/{examId}/submissions/{studentId}/{fileName} {
      allow get: if isAdmin() || classTutorFor(subjectId) ||
        (isSignedIn() && request.auth.uid == studentId) ||
        isParentOfStudent(studentId);
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == studentId && studentWorkFileOk();
      allow delete: if isAdmin() || classTutorFor(subjectId) ||
        (isSignedIn() && request.auth.uid == studentId);
    }

    // =====================================================
    // STUDENT HOMEWORK / PDF-EXAM UPLOADS
    // Path: classroom-files/{subjectId}/{classroomId}/{itemId}/submissions/{studentId}/{file}
    // =====================================================
    match /classroom-files/{subjectId}/{classroomId}/{itemId}/submissions/{studentId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if isSignedIn() && request.auth.uid == studentId && studentWorkFileOk();
      allow delete: if isAdmin() || classTutorFor(subjectId);
    }

    // =====================================================
    // GRADED OUTPUT (ink burned in)
    // Path: graded-submissions/{subjectId}/{classroomId}/{itemId}/{studentId}/{file}
    // =====================================================
    match /graded-submissions/{subjectId}/{classroomId}/{itemId}/{studentId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if (isAdmin() || classTutorFor(subjectId)) &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf');
      allow delete: if isAdmin() || classTutorFor(subjectId);
    }

    // Legacy graded files (old path without subjectId)
    match /graded-submissions/{classroomId}/{itemId}/{studentId}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // =====================================================
    // UNATTENDED WORK REPORTS — written by Cloud Functions
    // =====================================================
    match /unattended-reports/{studentId}/{fileName} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == studentId) || isParentOfStudent(studentId);
      allow list, write: if false;
    }

    // =====================================================
    // STUDENT PROFILE FILES
    // =====================================================
    match /students/{studentId}/profile/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == studentId);
      allow write: if isSignedIn() && request.auth.uid == studentId &&
        underSizeLimit() && isEducationalFile();
    }

    // =====================================================
    // STUDENT PROFILE PHOTOS
    // =====================================================
    match /student-photos/{uid}/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // =====================================================
    // Paisley Tech Studio — build files (techBuilds/{studentId}/{buildId}/{file})
    // =====================================================
    match /techBuilds/{studentId}/{buildId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isAdmin() ||
        (firestore.exists(/databases/(default)/documents/techCoaches/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/techCoaches/$(request.auth.uid)).data.status == 'Active' &&
          firestore.get(/databases/(default)/documents/techStudents/$(studentId)).data.get('coachId', '') == request.auth.uid) ||
        firestore.exists(/databases/(default)/documents/techGuardianLinks/$(request.auth.uid + '_' + studentId)));
      // Builder branch first: it uses techStudents + techBuilds, its 2-doc budget.
      allow create, update: if isSignedIn() && (
        (request.auth.uid == studentId &&
          firestore.get(/databases/(default)/documents/techStudents/$(studentId)).data.status == 'Active' &&
          firestore.get(/databases/(default)/documents/techBuilds/$(buildId)).data.studentId == studentId) ||
        (request.auth.uid != studentId && isAdmin())) &&
        underSizeLimit() &&
        !request.resource.contentType.matches('text/html') &&
        !request.resource.contentType.matches('.*javascript.*');
      allow delete: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
    }

    // =====================================================
    // Paisley Tech Studio � mission study materials (techContent/{contentId}/{file})
    // A rule may touch at most 2 distinct Firestore docs per request (admins/,
    // techCoaches/, techContent/ ... each counts once), so every branch below
    // stays within 2. createdBy on the mission proves the uploader is its coach:
    // firestore.rules only lets an Active TECH coach create one with their uid.
    // Builders open materials through the token download URL saved on the mission.
    // =====================================================
    function techActiveIn(coll) {
      return firestore.exists(/databases/(default)/documents/$(coll)/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/$(coll)/$(request.auth.uid)).data.status == 'Active';
    }
    function techMissionOwner(contentId) {
      return firestore.get(/databases/(default)/documents/techContent/$(contentId)).data.get('createdBy', '') == request.auth.uid;
    }
    match /techContent/{contentId}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches') || techActiveIn('techStudents'));
      allow create, update: if isSignedIn() && (isAdmin() || techMissionOwner(contentId)) &&
        ((request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024) ||
          ((isEducationalFile() || request.resource.contentType.matches('text/(plain|csv)') ||
            request.resource.contentType.matches('application/(msword|vnd[.]openxmlformats-officedocument[.].*|vnd[.]ms-.*|zip)')) &&
            request.resource.size < 50 * 1024 * 1024)) &&
        !request.resource.contentType.matches('text/html') &&
        !request.resource.contentType.matches('.*javascript.*');
      allow delete: if isSignedIn() && (isAdmin() || techMissionOwner(contentId));
    }

    // Paisley Tech Studio classes: lesson videos and files. Any admin or active coach can
    // upload (the lesson may not exist yet when its video goes up). Builders and parents play
    // them through the link saved on the lesson. Two Firestore docs at most, as above.
    match /techLessons/{lessonId}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches') || techActiveIn('techStudents'));
      allow create, update: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches')) &&
        ((request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024) ||
          ((isEducationalFile() || request.resource.contentType.matches('text/(plain|csv)') ||
            request.resource.contentType.matches('application/(msword|vnd[.]openxmlformats-officedocument[.].*|vnd[.]ms-.*|zip)')) &&
            request.resource.size < 50 * 1024 * 1024)) &&
        !request.resource.contentType.matches('text/html') &&
        !request.resource.contentType.matches('.*javascript.*');
      allow delete: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches'));
    }

    // Tech Studio class work: pictures, video, sound and fonts a builder uploads into their
    // Code IDE for one lesson. Builders and families open them through the saved link.
    function techMediaUpload(maxMb) {
      return (request.resource.contentType.matches('(image|video|audio|font)/.*') ||
          request.resource.contentType.matches('application/(font-woff|x-font-.*|octet-stream)')) &&
        !request.resource.contentType.matches('image/svg.*') &&
        request.resource.size < maxMb * 1024 * 1024;
    }
    match /techWork/{studentId}/{workId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isAdmin() || techActiveIn('techCoaches'));
      allow create, update: if isSignedIn() && request.auth.uid == studentId && techActiveIn('techStudents') && techMediaUpload(50);
      allow delete: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
    }
    // A group's shared Code IDE uploads. Only members upload (one Firestore doc: the group).
    match /techGroupWork/{groupId}/{taskId}/{fileName} {
      allow read: if isSignedIn() &&
        (request.auth.uid in firestore.get(/databases/(default)/documents/techGroups/$(groupId)).data.get('memberIds', []) || isAdmin());
      allow create, update: if isSignedIn() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/techGroups/$(groupId)).data.get('memberIds', []) &&
        techMediaUpload(50);
      allow delete: if isSignedIn() &&
        (request.auth.uid in firestore.get(/databases/(default)/documents/techGroups/$(groupId)).data.get('memberIds', []) || isAdmin());
    }
    // Marked copies (PDF with the coach's ink) of class work and group tasks.
    match /techGraded/{folder}/{workId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == folder || isAdmin() || techActiveIn('techCoaches'));
      allow create, update: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches')) &&
        request.resource.contentType == 'application/pdf' && request.resource.size < 30 * 1024 * 1024;
      allow delete: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches'));
    }

    // Tech Studio navigation video. Only the Studio Desk uploads it; only active
    // builders can get a link to it (builders first: a request may touch only 2 Firestore docs).
    match /techSettings/{folder}/{fileName} {
      allow read: if isSignedIn() && (techActiveIn('techStudents') || isAdmin());
      allow create, update: if isSignedIn() && isAdmin() &&
        request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isSignedIn() && isAdmin();
    }

    // Tech Studio homework: files a coach or the Studio Desk attaches for builders to
    // download (techHomework/{homeworkId}/...), and what a builder uploads for it
    // (techHomeworkWork/{uid}/{homeworkId}/...). Everyone opens them through the saved link.
    // Web pages, scripts and SVG are refused. Two Firestore docs at most per request.
    function techHomeworkFileOk() {
      return request.resource.size < 50 * 1024 * 1024 &&
        !request.resource.contentType.matches('(text/html|application/xhtml[+]xml|image/svg.*|text/xml|application/xml)') &&
        !request.resource.contentType.matches('.*javascript.*');
    }
    match /techHomework/{homeworkId}/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches') || techActiveIn('techStudents'));
      allow create, update: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches')) && techHomeworkFileOk();
      allow delete: if isSignedIn() && (isAdmin() || techActiveIn('techCoaches'));
    }
    match /techHomeworkWork/{studentId}/{homeworkId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isAdmin() || techActiveIn('techCoaches'));
      allow create, update: if isSignedIn() && request.auth.uid == studentId && techActiveIn('techStudents') && techHomeworkFileOk();
      allow delete: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
    }

    // Tech Studio chats: pictures, screenshots and files sent in builder <-> coach
    // (techChats) and family <-> coach (techGuardianChats) conversations. Each sender
    // uploads under their own uid; one Firestore doc (the chat) plus admins/ at most.
    // Web pages, scripts and SVG are refused; everything is opened through the saved link.
    function techChatFileOk() {
      return request.resource.size < 25 * 1024 * 1024 &&
        !request.resource.contentType.matches('(text/html|application/xhtml[+]xml|image/svg.*|text/xml|application/xml)') &&
        !request.resource.contentType.matches('.*javascript.*');
    }
    match /techChats/{chatId}/{uid}/{fileName} {
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/techChats/$(chatId)).data.studentId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/techChats/$(chatId)).data.get('coachId', '') == request.auth.uid ||
        isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && techChatFileOk() && (
        firestore.get(/databases/(default)/documents/techChats/$(chatId)).data.studentId == uid ||
        firestore.get(/databases/(default)/documents/techChats/$(chatId)).data.get('coachId', '') == uid ||
        isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }
    match /techGuardianChats/{chatId}/{uid}/{fileName} {
      allow read: if isSignedIn() && (
        firestore.get(/databases/(default)/documents/techGuardianChats/$(chatId)).data.parentUid == request.auth.uid ||
        firestore.get(/databases/(default)/documents/techGuardianChats/$(chatId)).data.get('coachId', '') == request.auth.uid ||
        isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && techChatFileOk() && (
        firestore.get(/databases/(default)/documents/techGuardianChats/$(chatId)).data.parentUid == uid ||
        firestore.get(/databases/(default)/documents/techGuardianChats/$(chatId)).data.get('coachId', '') == uid ||
        isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // Parent ads and newsletters: admins upload; pictures and video only.
    // Signed-in parents and emails use the token download URL saved on the ad.
    match /parentMedia/{fileName} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isAdmin() && (
        (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024) ||
        (request.resource.contentType.matches('image/(jpeg|png|gif|webp)') && request.resource.size < 25 * 1024 * 1024));
      allow delete: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}